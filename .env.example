# Used by the Vercel serverless function api/contact.js
# Get a key at https://resend.com (free tier works)
RESEND_API_KEY=re_xxxxxxxxxxxx
# Where contact-form messages are delivered
CONTACT_TO_EMAIL=you@example.com
# Optional: verified sender (defaults to Resend's onboarding sender)
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
